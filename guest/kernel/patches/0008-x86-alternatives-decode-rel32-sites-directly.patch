From: microvm <microvm@localhost>
Subject: [PATCH] x86/alternatives: decode rel32 return/retpoline sites directly

apply_returns() and apply_retpolines() run the generic instruction
decoder on every site objtool recorded, ~10k of them, and the decoder is
about a fifth of the kernel's boot time on a microVM. The sites are
almost all JMP/CALL rel32 or Jcc rel32, whose length and target follow
from the first one or two bytes. Decode those directly and leave every
other encoding to insn_decode_kernel(). The patched bytes are identical.

--- a/arch/x86/kernel/alternative.c	2026-11-04 07:56:14.314517807 +0100
+++ b/arch/x86/kernel/alternative.c	2026-11-04 07:56:14.354583435 +0100
@@ -952,6 +952,38 @@
 }
 
 /*
+ * Return-thunk and retpoline sites are rel32 branches: JMP (e9), CALL (e8)
+ * or Jcc (0f 8x), whose length and target follow from the first one or two
+ * bytes. Decode those directly: running the generic decoder on each of the
+ * ~10k sites is most of the cost of boot-time patching. Anything else
+ * (prefixed forms, Jcc.d8, ...) still goes through insn_decode_kernel().
+ */
+static int decode_site(struct insn *insn, void *addr)
+{
+	const u8 *p = addr;
+
+	if (p[0] == JMP32_INSN_OPCODE || p[0] == CALL_INSN_OPCODE) {
+		memset(insn, 0, sizeof(*insn));
+		insn_field_set(&insn->opcode, p[0], 1);
+		insn_field_set(&insn->immediate, *(const s32 *)(p + 1), 4);
+		insn->length = 5;
+	} else if (p[0] == 0x0f && (p[1] & 0xf0) == 0x80) {
+		memset(insn, 0, sizeof(*insn));
+		insn_field_set(&insn->opcode, p[0] | (p[1] << 8), 2);
+		insn_field_set(&insn->immediate, *(const s32 *)(p + 2), 4);
+		insn->length = 6;
+	} else {
+		return insn_decode_kernel(insn, addr);
+	}
+	insn->kaddr = insn->next_byte = p;
+	insn->end_kaddr = p + MAX_INSN_SIZE;
+	insn->x86_64 = 1;
+	insn->opnd_bytes = 4;
+	insn->addr_bytes = 8;
+	return 0;
+}
+
+/*
  * Generated by 'objtool --retpoline'.
  */
 void __init_or_module noinline apply_retpolines(s32 *start, s32 *end)
@@ -966,7 +998,7 @@
 		u8 op1, op2;
 		u8 *dest;
 
-		ret = insn_decode_kernel(&insn, addr);
+		ret = decode_site(&insn, addr);
 		if (WARN_ON_ONCE(ret < 0))
 			continue;
 
@@ -1072,7 +1104,7 @@
 		u8 bytes[16];
 		u8 op;
 
-		ret = insn_decode_kernel(&insn, addr);
+		ret = decode_site(&insn, addr);
 		if (WARN_ON_ONCE(ret < 0))
 			continue;
 
