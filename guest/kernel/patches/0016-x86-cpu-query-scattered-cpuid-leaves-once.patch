From: microvm <microvm@localhost>
Subject: [PATCH] x86/cpu: query each scattered CPUID leaf once

init_scattered_cpuid_features() runs two CPUIDs per table entry: the
range's maximum leaf, then the entry's leaf. That is 72 per call for 36
entries, where 19 distinct values are needed. The table is sorted by leaf,
so keep the last range maximum and the last leaf's registers. In a VM each
CPUID traps to the hypervisor, and this runs twice per boot (early and
full CPU identification).

--- a/arch/x86/kernel/cpu/scattered.c	2026-10-30 13:06:41.000000000 +0100
+++ b/arch/x86/kernel/cpu/scattered.c	2026-11-04 08:39:51.437200897 +0100
@@ -63,23 +63,38 @@
 	{ 0, 0, 0, 0, 0 }
 };
 
+/*
+ * The table is sorted by leaf, so consecutive entries mostly share both the
+ * range's maximum leaf and the leaf itself: query each once. In a VM every
+ * CPUID traps to the hypervisor, and this runs twice per boot.
+ */
 void init_scattered_cpuid_features(struct cpuinfo_x86 *c)
 {
-	u32 max_level;
+	u32 max_level = 0, range = 1;	/* ranges have the low 16 bits clear */
+	u32 level = 0, sub_leaf = 0;
+	bool have_regs = false;
 	u32 regs[4];
 	const struct cpuid_bit *cb;
 
 	for (cb = cpuid_bits; cb->feature; cb++) {
 
 		/* Verify that the level is valid */
-		max_level = cpuid_eax(cb->level & 0xffff0000);
+		if ((cb->level & 0xffff0000) != range) {
+			range = cb->level & 0xffff0000;
+			max_level = cpuid_eax(range);
+		}
 		if (max_level < cb->level ||
 		    max_level > (cb->level | 0xffff))
 			continue;
 
-		cpuid_count(cb->level, cb->sub_leaf, &regs[CPUID_EAX],
-			    &regs[CPUID_EBX], &regs[CPUID_ECX],
-			    &regs[CPUID_EDX]);
+		if (!have_regs || cb->level != level || cb->sub_leaf != sub_leaf) {
+			cpuid_count(cb->level, cb->sub_leaf, &regs[CPUID_EAX],
+				    &regs[CPUID_EBX], &regs[CPUID_ECX],
+				    &regs[CPUID_EDX]);
+			level = cb->level;
+			sub_leaf = cb->sub_leaf;
+			have_regs = true;
+		}
 
 		if (regs[cb->reg] & (1 << cb->bit))
 			set_cpu_cap(c, cb->feature);
