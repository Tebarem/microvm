From: microvm <microvm@localhost>
Subject: [PATCH] x86/alternatives: decode less in optimize_nops()

optimize_nops() runs on every alternative site at boot, and decodes every
instruction in it, including each single-byte 0x90 the site is padded
with. In a microVM boot that decoding is ~10% of guest time.

Skip the decoder where its answer is known in advance:
- a buffer with no 0x90 byte and no 0f 1f pair cannot hold a NOP that
  insn_is_nop() would match, so there is nothing to do;
- 0x90 at an instruction boundary is a one-byte NOP: it is not a prefix,
  so a decode would always report exactly that.

The resulting bytes are unchanged.

--- a/arch/x86/kernel/alternative.c	2026-11-04 08:36:13.832260687 +0100
+++ b/arch/x86/kernel/alternative.c	2026-11-04 08:36:13.852214443 +0100
@@ -376,6 +376,10 @@
 	struct insn insn;
 
 	for (; offset < len; offset += insn.length) {
+		if (buf[offset] == 0x90) { /* NOP, see optimize_nops() */
+			insn.length = 1;
+			continue;
+		}
 		if (insn_decode_kernel(&insn, &buf[offset]))
 			break;
 
@@ -387,20 +391,48 @@
 }
 
 /*
+ * Every NOP that insn_is_nop() matches has a 0x90 or a 0f 1f opcode, so a
+ * buffer with neither has no NOPs to optimize.
+ */
+static bool may_have_nops(const u8 *buf, size_t len)
+{
+	for (size_t i = 0; i < len; i++) {
+		if (buf[i] == 0x90 || (buf[i] == 0x0f && i + 1 < len && buf[i + 1] == 0x1f))
+			return true;
+	}
+	return false;
+}
+
+/*
  * "noinline" to cause control flow change and thus invalidate I$ and
  * cause refetch after modification.
+ *
+ * This runs on every alternative site at boot, and the instruction decoder
+ * is most of its cost. Skip decoding where the answer is known: buffers
+ * without NOPs, and 0x90 at an instruction boundary (always a one-byte NOP
+ * there, since it is not a prefix), which is how alternatives are padded.
  */
 static void noinline optimize_nops(const u8 * const instr, u8 *buf, size_t len)
 {
+	if (!may_have_nops(buf, len))
+		return;
+
 	for (int next, i = 0; i < len; i = next) {
 		struct insn insn;
+		bool nop;
 
-		if (insn_decode_kernel(&insn, &buf[i]))
-			return;
+		if (buf[i] == 0x90) {
+			insn.length = 1;
+			nop = true;
+		} else {
+			if (insn_decode_kernel(&insn, &buf[i]))
+				return;
+			nop = insn_is_nop(&insn);
+		}
 
 		next = i + insn.length;
 
-		if (insn_is_nop(&insn)) {
+		if (nop) {
 			int nop = i;
 
 			/* Has the NOP already been optimized? */
