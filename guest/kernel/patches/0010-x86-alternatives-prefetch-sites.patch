From: microvm <microvm@localhost>
Subject: [PATCH] x86/alternatives: prefetch return/retpoline sites

The ~11k return-thunk and retpoline sites are spread over the whole
kernel text, about one every five cache lines, so with decoding made
cheap (0008) each site is mostly a cache and TLB miss. Prefetch the site
16 entries ahead for writing. Measured: -70 us of a 3.3 ms microVM boot.

--- a/arch/x86/kernel/alternative.c	2026-11-04 08:07:24.789944754 +0100
+++ b/arch/x86/kernel/alternative.c	2026-11-04 08:07:24.826204455 +0100
@@ -984,6 +984,18 @@
 }
 
 /*
+ * The sites are spread over the whole kernel text, one every few cache
+ * lines, so each one is a cache (and often TLB) miss. Fetch a few ahead.
+ */
+#define PREFETCH_SITES 16
+
+static __always_inline void prefetch_site(s32 *s, s32 *end)
+{
+	if (s + PREFETCH_SITES < end)
+		prefetchw((void *)(s + PREFETCH_SITES) + s[PREFETCH_SITES]);
+}
+
+/*
  * Generated by 'objtool --retpoline'.
  */
 void __init_or_module noinline apply_retpolines(s32 *start, s32 *end)
@@ -998,6 +1010,7 @@
 		u8 op1, op2;
 		u8 *dest;
 
+		prefetch_site(s, end);
 		ret = decode_site(&insn, addr);
 		if (WARN_ON_ONCE(ret < 0))
 			continue;
@@ -1104,6 +1117,7 @@
 		u8 bytes[16];
 		u8 op;
 
+		prefetch_site(s, end);
 		ret = decode_site(&insn, addr);
 		if (WARN_ON_ONCE(ret < 0))
 			continue;
